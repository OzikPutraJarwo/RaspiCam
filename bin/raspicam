#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="${RASPICAM_DIR:-/opt/raspicam}"
SERVICE_NAME="raspicam"

if [ "$(id -u)" -eq 0 ]; then
  SUDO=""
else
  SUDO="sudo"
fi

usage() {
  cat <<TEXT
RaspiCam control

  raspicam start        Start the service
  raspicam stop         Stop the service
  raspicam restart      Restart the service
  raspicam status       Show service status
  raspicam logs         Follow the service log
  raspicam url          Show the local dashboard address
  raspicam update       Pull the latest version and restart
  raspicam uninstall    Remove RaspiCam from this device
TEXT
}

case "${1:-}" in
  start) $SUDO systemctl start $SERVICE_NAME ;;
  stop) $SUDO systemctl stop $SERVICE_NAME ;;
  restart) $SUDO systemctl restart $SERVICE_NAME ;;
  status) $SUDO systemctl status $SERVICE_NAME --no-pager ;;
  logs) $SUDO journalctl -u $SERVICE_NAME -n 200 -f ;;
  url)
    PORT="$(python3 -c "import json;print(json.load(open('$INSTALL_DIR/data/config.json'))['server']['port'])" 2>/dev/null || echo 8080)"
    echo "http://$(hostname -I | awk '{print $1}'):$PORT"
    ;;
  update)
    OWNER="$(stat -c '%U' "$INSTALL_DIR")"
    run_as() {
      if [ "$(id -un)" = "$OWNER" ]; then
        "$@"
      elif [ "$(id -u)" -eq 0 ] && command -v runuser >/dev/null 2>&1; then
        runuser -u "$OWNER" -- "$@"
      else
        sudo -u "$OWNER" "$@"
      fi
    }
    run_as git -C "$INSTALL_DIR" pull --ff-only
    run_as "$INSTALL_DIR/.venv/bin/pip" install --quiet -r "$INSTALL_DIR/requirements.txt"
    $SUDO systemctl restart $SERVICE_NAME
    echo "RaspiCam updated."
    ;;
  uninstall) bash "$INSTALL_DIR/uninstall.sh" ;;
  *) usage ;;
esac
